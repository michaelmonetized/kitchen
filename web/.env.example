# Pull real values with authorized CLIs (from repo root):
#   bash scripts/setup-env.sh
# Or manually:
#   clerk env pull --app <app_id> --file .env.local
#   npx convex dev --once --configure new --team <team> --project kitchen
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN "$CLERK_JWT_ISSUER_DOMAIN"
#   vercel env pull .env.vercel --yes

# Clerk (clerk env pull — beta uses pk_test_* / sk_test_*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Frontend API URL from Clerk Dashboard → API keys, or decode pk_test_* base64 segment
# e.g. https://big-bird-31.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Convex (convex dev --configure / .env.local after configure)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Site (production deploy URL)
NEXT_PUBLIC_SITE_URL=https://kitchen.vercel.app

# Collab relay (npm run relay -w web — separate Node WS process)
NEXT_PUBLIC_COLLAB_RELAY_URL=ws://127.0.0.1:9473
COLLAB_RELAY_HOST=127.0.0.1
COLLAB_RELAY_PORT=9473
COLLAB_RELAY_SECRET=dev-collab-relay-secret

# Smoke test (web/scripts/smoke.mjs — optional overrides)
# SMOKE_BASE_URL=https://kitchen.vercel.app
# SMOKE_TEST_EMAIL=kitchen-smoke@hustlestack.dev
# SMOKE_TEST_PASSWORD=KitchenSmokeTest1!