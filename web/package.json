    "relay": "tsx server/collab-relay.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node scripts/smoke.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.0",
    "@kitchen/collab-protocol": "0.0.1",
    "@kitchen/collab-relay": "0.0.1",
    "convex": "^1.31.0",
    "diff": "^9.0.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "tsx": "^4.19.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
